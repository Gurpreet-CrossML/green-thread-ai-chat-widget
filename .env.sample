# Copy to .env.development (for `npm run dev`) or .env.production (for
# `npm run build`) and fill in. An embed's data-* attributes win over these.

# The store's widget key (dashboard -> Settings -> Stores -> Get widget
# script). It also picks the store: the backend resolves the store's name,
# code, language and look from it. Local development only; a production embed
# passes its own data-widget-key.
VITE_WIDGET_KEY=
# The backend API, e.g. http://localhost:8000/api. Required unless the embed
# passes data-api-base. Locally the backend must run with DEBUG=True, which
# accepts widget calls from localhost.
VITE_API_BASE_URL=
# The QR photo capture page. Default: https://chatbot.renkaat247.fi/src/capture/
VITE_CAPTURE_URL=
