# Copy to .env.development (for `npm run dev`) or .env.production (for
# `npm run build`) and fill in. Every value is optional.

# Store code to use on localhost (development only; the page hostname
# matches no store there).
VITE_STORE_CODE=renkaat247
# The store's widget key (Store Signal Django admin -> Store -> Widget key).
# Development only: a production embed passes its own data-widget-key.
VITE_WIDGET_KEY=
# The backend API, e.g. https://<your-backend-host>/api. Required unless the
# embed passes data-api-base.
VITE_API_BASE_URL=
# The QR photo capture page. Default: https://chatbot.renkaat247.fi/src/capture/
VITE_CAPTURE_URL=
